{
  "name": "offhand",
  "displayName": "Offhand",
  "description": "Free, lightweight commit model: suggests a Conventional Commits message right after `git add` in the terminal. Your data stays local and private.",
  "version": "0.1.0",
  "preview": true,
  "publisher": "JesserLahmer",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#3A0F14",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedJesserLahmer/commit-model.git"
  },
  "bugs": {
    "url": "https://github.com/AhmedJesserLahmer/commit-model/issues"
  },
  "homepage": "https://github.com/AhmedJesserLahmer/commit-model#readme",
  "keywords": [
    "git",
    "commit",
    "commit message",
    "conventional commits",
    "offline",
    "local model",
    "llama.cpp",
    "terminal"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "offhand.toggle",
        "title": "Turn On / Off",
        "category": "Offhand"
      },
      {
        "command": "offhand.start",
        "title": "Turn On",
        "category": "Offhand"
      },
      {
        "command": "offhand.stop",
        "title": "Turn Off",
        "category": "Offhand"
      },
      {
        "command": "offhand.generate",
        "title": "Suggest Commit Message in the Commit Box",
        "category": "Offhand",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "offhand.generate",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Offhand",
      "properties": {
        "offhand.modelUri": {
          "type": "string",
          "default": "hf:Jess2005/commit-model-CLI/commit-model-Q4_K_M.gguf",
          "description": "Where the model is downloaded from on first start: hf:<user>/<repo>/<file> (Hugging Face) or an https URL."
        },
        "offhand.modelPath": {
          "type": "string",
          "default": "",
          "description": "Path to a local .gguf model. When set, it's used instead of downloading modelUri (for development)."
        },
        "offhand.gpu": {
          "type": "string",
          "enum": [
            "auto",
            "cpu"
          ],
          "default": "auto",
          "description": "Use the GPU when one is available (auto), or always run on the CPU."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "test:smoke": "npm run compile && node test/smoke.mjs ../merged_weights_quantized_model/quantized-model/commit-model-Q4_K_M.gguf",
    "test:integration": "npm run compile && node test/integration/runTest.js",
    "test:unit": "npm run compile && node --test test/unit.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
