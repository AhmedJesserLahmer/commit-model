{
  "name": "commit-model",
  "displayName": "Commit Model",
  "description": "Writes Conventional Commits messages from your staged changes with a small local model. Runs offline on your machine; the model and the llama.cpp engine download on first start.",
  "version": "0.1.0",
  "publisher": "commit-model",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "commitModel.toggle",
        "title": "Turn On / Off",
        "category": "Commit Model"
      },
      {
        "command": "commitModel.start",
        "title": "Turn On",
        "category": "Commit Model"
      },
      {
        "command": "commitModel.stop",
        "title": "Turn Off",
        "category": "Commit Model"
      },
      {
        "command": "commitModel.generate",
        "title": "Suggest Commit Message in the Commit Box",
        "category": "Commit Model",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitModel.generate",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Commit Model",
      "properties": {
        "commitModel.modelUri": {
          "type": "string",
          "default": "hf:<username>/<repo>/commit-model-Q4_K_M.gguf",
          "description": "Where to download the model from on first start (Hugging Face URI or https URL)."
        },
        "commitModel.modelPath": {
          "type": "string",
          "default": "",
          "description": "Path to a local .gguf model. When set, it's used instead of downloading modelUri."
        },
        "commitModel.gpu": {
          "type": "string",
          "enum": [
            "auto",
            "cpu"
          ],
          "default": "auto",
          "description": "Use the GPU when one is available (auto), or always run on the CPU."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "test:smoke": "npm run compile && node test/smoke.mjs ../merged_weights_quantized_model/quantized-model/commit-model-Q4_K_M.gguf",
    "test:integration": "npm run compile && node test/integration/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
